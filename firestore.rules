rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Allow customers to submit orders and dispatch admin to read, update, and delete orders
      allow read, create, update, delete: if true;
    }
    match /products/{productId} {
      // Allow public customers to read active products and dispatch admin to add, update, delete
      allow read, create, update, delete: if true;
    }
    match /riders/{riderId} {
      // Allow dispatch admin to read, create, update, and delete delivery fleet riders
      allow read, create, update, delete: if true;
    }
  }
}
