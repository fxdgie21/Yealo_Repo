{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer ice order for delivery",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order tracking code, e.g. YLO-12345"
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the customer"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Contact phone or mobile number"
        },
        "deliveryAddress": {
          "type": "string",
          "description": "Specific delivery address or landmark"
        },
        "cityArea": {
          "type": "string",
          "description": "Town or city in Nueva Ecija"
        },
        "productName": {
          "type": "string",
          "description": "Name of the ice product (Tube Ice or Cube Ice)"
        },
        "bagSize": {
          "type": "string",
          "description": "Selected bag weight (1kg, 5kg, or 10kg)"
        },
        "quantity": {
          "type": "number",
          "description": "Number of bags ordered"
        },
        "total": {
          "type": "number",
          "description": "Total order amount in PHP"
        },
        "deliveryDate": {
          "type": "string",
          "description": "Requested delivery date"
        },
        "deliveryTime": {
          "type": "string",
          "description": "Requested delivery time slot"
        },
        "status": {
          "type": "string",
          "description": "Order status",
          "enum": ["Pending", "Preparing", "Out for Delivery", "Delivered", "Cancelled"]
        },
        "additionalNotes": {
          "type": "string",
          "description": "Optional instructions for the rider"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when order was submitted"
        }
      },
      "required": ["id", "customerName", "phoneNumber", "deliveryAddress", "cityArea", "productName", "bagSize", "quantity", "total", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Ice product item sold in stores",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product ID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the ice product"
        },
        "category": {
          "type": "string",
          "description": "Product category"
        },
        "description": {
          "type": "string",
          "description": "Short marketing description"
        },
        "price": {
          "type": "number",
          "description": "Base price (per 5kg bag)"
        },
        "unit": {
          "type": "string",
          "description": "Unit label, e.g. per 5kg bag"
        },
        "inStock": {
          "type": "boolean",
          "description": "Availability status"
        },
        "image": {
          "type": "string",
          "description": "Product photograph (Data URL or hosted image URL)"
        }
      },
      "required": ["id", "name", "price"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Live incoming customer ice orders for dispatch management"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Configurable ice products and prices managed by Store Admin"
    }
  }
}
