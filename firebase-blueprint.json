{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer ice order for delivery",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order tracking code, e.g. YLO-12345"
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the customer"
        },
        "phoneNumber": {
          "type": "string",
          "description": "Contact phone or mobile number"
        },
        "deliveryAddress": {
          "type": "string",
          "description": "Specific delivery address or landmark"
        },
        "cityArea": {
          "type": "string",
          "description": "Town or city in Nueva Ecija"
        },
        "productName": {
          "type": "string",
          "description": "Name of the ice product (Tube Ice or Cube Ice)"
        },
        "bagSize": {
          "type": "string",
          "description": "Selected bag weight (1kg, 5kg, or 10kg)"
        },
        "quantity": {
          "type": "number",
          "description": "Number of bags ordered"
        },
        "total": {
          "type": "number",
          "description": "Total order amount in PHP"
        },
        "deliveryDate": {
          "type": "string",
          "description": "Requested delivery date"
        },
        "deliveryTime": {
          "type": "string",
          "description": "Requested delivery time slot"
        },
        "status": {
          "type": "string",
          "description": "Order status",
          "enum": ["Pending", "Preparing", "Out for Delivery", "Delivered", "Cancelled"]
        },
        "additionalNotes": {
          "type": "string",
          "description": "Optional instructions for the rider"
        },
        "riderId": {
          "type": "string",
          "description": "Assigned delivery rider ID"
        },
        "riderName": {
          "type": "string",
          "description": "Assigned rider name"
        },
        "review": {
          "type": "object",
          "description": "Customer rating, compliments, and comment for the delivery rider after delivery",
          "properties": {
            "rating": { "type": "number" },
            "comment": { "type": "string" },
            "compliments": { "type": "array", "items": { "type": "string" } },
            "submittedAt": { "type": "string" },
            "reviewerName": { "type": "string" },
            "riderId": { "type": "string" },
            "riderName": { "type": "string" }
          }
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when order was submitted"
        }
      },
      "required": ["id", "customerName", "phoneNumber", "deliveryAddress", "cityArea", "productName", "bagSize", "quantity", "total", "status", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Ice product item sold in stores",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product ID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the ice product"
        },
        "category": {
          "type": "string",
          "description": "Product category"
        },
        "description": {
          "type": "string",
          "description": "Short marketing description"
        },
        "price": {
          "type": "number",
          "description": "Base price (per 5kg bag)"
        },
        "unit": {
          "type": "string",
          "description": "Unit label, e.g. per 5kg bag"
        },
        "inStock": {
          "type": "boolean",
          "description": "Availability status"
        },
        "image": {
          "type": "string",
          "description": "Product photograph (Data URL or hosted image URL)"
        }
      },
      "required": ["id", "name", "price"]
    },
    "Rider": {
      "title": "Rider",
      "description": "Delivery fleet rider profile with contact and vehicle details",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique rider identifier"
        },
        "name": {
          "type": "string",
          "description": "Full name or callsign of the delivery rider"
        },
        "phone": {
          "type": "string",
          "description": "Mobile contact number for dispatch and customer coordination"
        },
        "vehicleType": {
          "type": "string",
          "description": "Type of vehicle used (e.g. Insulated Cold-Box Tricycle, Motorcycle)"
        },
        "plateNumber": {
          "type": "string",
          "description": "TODA registration body number or vehicle license plate"
        },
        "assignedZone": {
          "type": "string",
          "description": "Primary delivery zone or town assigned to the rider"
        },
        "status": {
          "type": "string",
          "description": "Rider availability status",
          "enum": ["Available", "On Delivery", "Off Duty"]
        },
        "notes": {
          "type": "string",
          "description": "Special equipment, cooler capacity, or emergency contact notes"
        },
        "rating": {
          "type": "number",
          "description": "Average customer rating score (1 to 5 stars)"
        },
        "totalRatings": {
          "type": "number",
          "description": "Sum of all ratings submitted by customers"
        },
        "reviewsCount": {
          "type": "number",
          "description": "Total count of ratings received"
        },
        "completedDeliveries": {
          "type": "number",
          "description": "Count of orders delivered"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when rider was registered"
        }
      },
      "required": ["id", "name", "phone", "vehicleType", "plateNumber", "status"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Live incoming customer ice orders for dispatch management"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Configurable ice products and prices managed by Store Admin"
    },
    "/riders/{riderId}": {
      "schema": "Rider",
      "description": "Delivery fleet riders managed by Store Owner / Dispatch Admin"
    }
  }
}
